{
    "name": "jovian/venusian-gtk",
    "description": "Linux GTK4 support within Venusian PHP Framework",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "framework",
        "venusian",
        "gtk4",
        "bindings",
        "macos"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/appkit/0.8.x/overview",
    "support": {
        "docs": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/appkit/0.8.x/overview",
        "issues": "https://github.com/jovian/appkit/issues",
        "source": "https://github.com/jovian/appkit"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-mbstring": "*",
        "jovian/gtk": "^0.8.0",
        "microscrap/scrapyard-evdev": "^0.8.0",
        "venusian-surface/bridge": "^0.8.0",
        "venusian-surface/contracts": "^0.8.0",
        "venusian-surface/drawing": "^0.8.0",
        "venusian-surface/human-input": "^0.8.0",
        "venusian-surface/native-windows": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },

    "autoload": {
        "psr-4": {
            "Jovian\\Venusian\\GTK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Venusian\\GTK\\Providers\\VenusianGTKServiceProvider"
            ],
            "aliases": {

            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

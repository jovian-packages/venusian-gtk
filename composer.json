{
    "name": "jovian/venusian-gtk",
    "description": "GTK 4 toolkit driver for the Venusian Surface bridge: connects PHP to GtkApplication, opens its windows and builds their menu bars through ext-gtk.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "bridge",
        "gtk",
        "gtk4",
        "linux"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-gtk/0.10.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-gtk/issues",
        "source": "https://github.com/jovian-packages/venusian-gtk"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-gtk": "^0.10",
        "venusian-surface/bridge": "^0.10.0",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/windows": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.10.1",
        "venusian-voyager/vessel": "^0.10.1"
    },
    "suggest": {
        "ext-appkit": "Required on macOS: GTK runs on NSApplication there and only AppKit can bring the process forward when a window is presented."
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Toolkits\\GTK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Toolkits\\GTK\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Toolkits\\GTK\\Providers\\VenusianGTKServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
